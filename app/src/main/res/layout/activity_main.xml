<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/casino_green">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blackjack Trainer"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/gold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="200dp"
            android:layout_height="2dp"
            android:background="@color/gold"
            android:layout_marginBottom="32dp"/>

        <!-- Mode buttons -->
        <Button
            android:id="@+id/btnSums"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Card Sums"
            android:textSize="18sp"
            android:textColor="@color/gold"
            android:backgroundTint="@color/button_dark"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnOptimalPlay"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Optimal Play"
            android:textSize="18sp"
            android:textColor="@color/gold"
            android:backgroundTint="@color/button_dark"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnHiLo"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Hi-Lo Count"
            android:textSize="18sp"
            android:textColor="@color/gold"
            android:backgroundTint="@color/button_dark"
            android:layout_marginBottom="36dp"/>

        <!-- Score summary -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your scores:"
            android:textSize="14sp"
            android:textColor="@color/text_light"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvScoreSums"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sums: —"
            android:textSize="14sp"
            android:textColor="@color/text_light"/>

        <TextView
            android:id="@+id/tvScoreOptimal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Optimal Play: —"
            android:textSize="14sp"
            android:textColor="@color/text_light"/>

        <TextView
            android:id="@+id/tvScoreHiLo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hi-Lo Count: —"
            android:textSize="14sp"
            android:textColor="@color/text_light"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnResetScores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset Scores"
            android:textSize="13sp"
            android:textColor="@color/text_light"
            android:backgroundTint="@color/casino_green_dark"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
